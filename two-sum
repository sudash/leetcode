https://leetcode.com/problems/two-sum/ 

Given an array of integers nums and an integer target, return indices of the two numbers such that they add up to target.

You may assume that each input would have exactly one solution, and you may not use the same element twice.

You can return the answer in any order.


Example 1:

Input: nums = [2,7,11,15], target = 9
Output: [0,1]
Explanation: Because nums[0] + nums[1] == 9, we return [0, 1].
Example 2:

Input: nums = [3,2,4], target = 6
Output: [1,2]
Example 3:

Input: nums = [3,3], target = 6
Output: [0,1]

======================================

// First Solution : Without help 

class Solution {
    public int[] twoSum(int[] nums, int target) {
        int[] resultArray = new int[2]; 
        int len = nums.length; 
        boolean found = false; 

        for(int i = 0 ; i<len && !found ; i++){
            resultArray[0] = i; 

            for(int j= i+1; j<len ; j++){
                if(nums[i] + nums[j] == target){
                    found = true;
                    resultArray[1] = j; 
                    
                    break;
                }
                        

            }
        }
        System.out.println(resultArray[0] +", " + resultArray[1]);
        return resultArray;
    }
}


// 2nd Solution based on some hints from AI. 
// Using Hashmpap, the solution can be found at the complexity O(n) 

class Solution {
    public int[] twoSum(int[] nums, int target) {
        int[] resultArray = new int[2]; 
        int len = nums.length; 
        boolean found = false; 
        HashMap<Integer,Integer> map = new HashMap<>();
        // Only one for loop 
        for(int i = 0; i< len; i++) {
        	int complement = target - nums[i]; 
        	
        	if(map.containsKey(complement)) {
        		resultArray[0] = i;
        		resultArray[1] = map.get(complement);
        		break;
        	}else {
        		map.put(nums[i], i);
        	}
        }
        System.out.println(resultArray[0] +", "+  resultArray[1]);
        return resultArray;
    }
}
